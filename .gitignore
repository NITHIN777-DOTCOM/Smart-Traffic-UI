# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/
out/

# TypeScript build info cache
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Editor & IDE directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary files & caches
.cache/
.temp/
tmp/

# Demo camera clips (~125 MB each, over GitHub's 100 MB limit) — drop them in locally
videos/*
!videos/.gitkeep
public/videos/*.mp4

# Python bridge (Option 1: bridge/)
bridge/.venv/
bridge/out/
__pycache__/
*.pyc
# Checkpoints copied in by bridge/scripts/swap_model.py (binary, from the PPO repo / lead)
bridge/models/*
!bridge/models/.gitkeep
*.mp4
